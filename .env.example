# Watchtower v2 — edge + latency + robustness
# cp .env.example .env && nano .env

BRAND_NAME=Watchtower
LOG_LEVEL=info
HEALTH_PORT=3847
DRY_RUN=false
STRICT_CONFIG=true
PUBLIC_BASE_URL=http://YOUR_PUBLIC_IP:3847

MAX_COINS=8
MAX_WATCH_ADDRESSES=25
RSS_CEILING_MB=750
WATCHDOG_INTERVAL_SEC=15
SQLITE_PATH=/home/ubuntu/watchtower/data/watchtower.db

# Edge-first defaults (commodity whale off until labeled)
SIGNALS_ENABLED=market,funding,liquidations
WATCH_COINS=bitcoin,ethereum,solana
PRICE_SYMBOLS=BTCUSDT,ETHUSDT,SOLUSDT
PRICE_BINANCE=true
PRICE_BYBIT=true
PRICE_FALLBACK_POLL_SEC=120
MARKET_EVAL_SEC=2
PRICE_MOVE_PCT=2.5
ALERT_COOLDOWN_SEC=900
ALERT_COALESCE_MS=3000

FUNDING_SYMBOLS=BTCUSDT,ETHUSDT,SOLUSDT
FUNDING_POLL_SEC=60
FUNDING_ZSCORE=2
FUNDING_FLIP_ABS=0.0001

LIQ_SYMBOLS=BTCUSDT,ETHUSDT,SOLUSDT
LIQ_BINANCE=true
LIQ_BYBIT=true
LIQ_WINDOW_SEC=60
LIQ_THRESHOLD_USD=2000000

COINGECKO_API_KEY=
ETH_RPC_URL=
WATCH_ADDRESSES=

TELEGRAM_BOT_TOKEN=
TELEGRAM_FREE_CHAT_ID=
TELEGRAM_PREMIUM_CHAT_ID=
TELEGRAM_OPS_CHAT_ID=
TELEGRAM_PREMIUM_INVITE_LINK=
TELEGRAM_MIN_INTERVAL_MS=40

TWITTER_API_KEY=
TWITTER_API_SECRET=
TWITTER_ACCESS_TOKEN=
TWITTER_ACCESS_SECRET=
TWEET_STYLE=compact
DISCORD_WEBHOOK_URL=

PAYMENT_PRIMARY=stripe
PAYMENT_FALLBACK=crypto
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_ID=
PREMIUM_PRICE_USD=29
CRYPTO_RAIL=nowpayments
CRYPTO_RAIL_API_KEY=
CRYPTO_RAIL_PAY_URL=

AFFILIATE_ENABLED=true
AFFILIATE_EXCHANGE_URL=
LEGAL_DISCLAIMER=Market data alerts for informational/entertainment purposes only. Not financial advice. Do your own research.
LEGAL_DISCLAIMER_SHORT=Not financial advice. DYOR.
