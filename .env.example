# Watchtower Framework — .env
# cp .env.example .env && nano .env
# Boot validates load-bearing keys; STRICT_CONFIG=true fails loud (default when not DRY_RUN).

BRAND_NAME=Watchtower
WATCHTOWER_MODE=all
LOG_LEVEL=info
POLL_INTERVAL_SEC=90
HEALTH_PORT=3847
DRY_RUN=false
STRICT_CONFIG=true

PUBLIC_BASE_URL=http://YOUR_PUBLIC_IP:3847

# Oracle 1 GB budget
MAX_COINS=8
MAX_WATCH_ADDRESSES=25

# v1 commodity adapters. Edge plugins = drop file in src/signals/ + add name here.
SIGNALS_ENABLED=market
WATCH_COINS=bitcoin,ethereum,solana
PRICE_MOVE_PCT=3
VOLUME_SPIKE_PCT=40
WHALE_MIN_AMOUNT=1000
ALERT_COOLDOWN_SEC=900

COINGECKO_API_KEY=
COINGECKO_BASE_URL=https://api.coingecko.com/api/v3

# Whale requires BOTH — unfiltered Transfer flood is refused (memory safety)
ETH_RPC_URL=
WATCH_ADDRESSES=

TELEGRAM_BOT_TOKEN=
TELEGRAM_FREE_CHAT_ID=
TELEGRAM_CHAT_ID=
TELEGRAM_PREMIUM_CHAT_ID=
TELEGRAM_PREMIUM_INVITE_LINK=

TWITTER_API_KEY=
TWITTER_API_SECRET=
TWITTER_ACCESS_TOKEN=
TWITTER_ACCESS_SECRET=
TWEET_STYLE=compact

DISCORD_WEBHOOK_URL=

# Payments — Stripe primary; crypto fallback (Stripe freezes signal-adjacent accounts)
PAYMENT_PRIMARY=stripe
PAYMENT_FALLBACK=crypto
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_ID=
STRIPE_SUCCESS_URL=
STRIPE_CANCEL_URL=
STRIPE_PRODUCT_NAME=Watchtower Premium Data Alerts
STRIPE_STATEMENT_DESCRIPTOR=WATCHTOWER DATA
PREMIUM_PRICE_USD=29

CRYPTO_RAIL=nowpayments
CRYPTO_RAIL_API_KEY=
CRYPTO_RAIL_IPN_SECRET=
CRYPTO_RAIL_PAY_URL=
CRYPTO_RAIL_WALLET=
CRYPTO_RAIL_CURRENCY=USDT

AFFILIATE_ENABLED=true
AFFILIATE_EXCHANGE_URL=
AFFILIATE_EXCHANGE_LABEL=Trade now
AFFILIATE_CTA_EVERY_N=1

UPGRADE_CTA=Premium whale feed → /upgrade
TWEET_UPGRADE_URL=

LEGAL_DISCLAIMER=Market data alerts for informational/entertainment purposes only. Not financial advice. Do your own research.
LEGAL_DISCLAIMER_SHORT=Not financial advice. DYOR.
