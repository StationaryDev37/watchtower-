# Watchtower Framework — single-source alerts + revenue
# cp .env.example .env && nano .env

BRAND_NAME=Watchtower
WATCHTOWER_MODE=all
LOG_LEVEL=info
POLL_INTERVAL_SEC=60
HEALTH_PORT=3847
DRY_RUN=false

# Public URL of this VM (Oracle public IP or domain) — used for Stripe + upgrade CTAs
PUBLIC_BASE_URL=http://YOUR_PUBLIC_IP:3847

# Signals (comma-separated): market,whale
SIGNALS_ENABLED=market,whale
WATCH_COINS=bitcoin,ethereum,solana,binancecoin,ripple
PRICE_MOVE_PCT=3
VOLUME_SPIKE_PCT=40
WHALE_MIN_AMOUNT=1000
ALERT_COOLDOWN_SEC=900

COINGECKO_API_KEY=
COINGECKO_BASE_URL=https://api.coingecko.com/api/v3
ETH_RPC_URL=
WATCH_ADDRESSES=

# Telegram — free channel = growth, premium channel = revenue
TELEGRAM_BOT_TOKEN=
TELEGRAM_FREE_CHAT_ID=
TELEGRAM_CHAT_ID=
TELEGRAM_PREMIUM_CHAT_ID=
TELEGRAM_PREMIUM_INVITE_LINK=

# Twitter / X (OAuth 1.0a Read+Write)
TWITTER_API_KEY=
TWITTER_API_SECRET=
TWITTER_ACCESS_TOKEN=
TWITTER_ACCESS_SECRET=

# Optional Discord
DISCORD_WEBHOOK_URL=

# Stripe — day-1 subscriptions (Checkout in the same process)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_ID=
STRIPE_SUCCESS_URL=
STRIPE_CANCEL_URL=
STRIPE_PRODUCT_NAME=Watchtower Premium Alerts
PREMIUM_PRICE_USD=29

# Affiliate CTAs on alerts (exchange / on-ramp referral links)
AFFILIATE_ENABLED=true
AFFILIATE_EXCHANGE_URL=
AFFILIATE_EXCHANGE_LABEL=Trade now
AFFILIATE_CTA_EVERY_N=1

UPGRADE_CTA=⚡ Get whale + faster alerts → /upgrade
TWEET_UPGRADE_URL=
