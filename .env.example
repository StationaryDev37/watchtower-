# Watchtower PR #2 — architectural pass
BRAND_NAME=Watchtower
LOG_LEVEL=info
HEALTH_PORT=3847
DRY_RUN=false
STRICT_CONFIG=true
PUBLIC_BASE_URL=http://YOUR_PUBLIC_IP:3847

SQLITE_PATH=/home/ubuntu/watchtower/data/watchtower.db
DB_PATH=./data/watchtower.db
SIGNALS_ENABLED=market,funding,liquidations
# For Unchained Solana-only:
# SIGNALS_ENABLED=solana_whale,new_pool_watch
# HEALTH_CRITICAL_DEPS=telegram,helius
WATCH_COINS=bitcoin,ethereum,solana

# --- Solana whale + new pools (Helius) ----------------------------------
HELIUS_KEY=
WHALE_SOL=500
MEGA_SOL=2000
PAID_LAG_MS=300000
PUBLISH_THRESHOLD_PAID=0.55
PUBLISH_THRESHOLD_FREE=0.65
HELIUS_MAX_INFLIGHT=4
HELIUS_SILENCE_MS=45000
SETTLER_TICK_MS=30000
# Aliases also accepted:
# TG_BOT_TOKEN=  TG_CHANNEL=@unchained_watchtower  TG_PAID_CHANNEL=
# X_API_KEY= X_API_SECRET= X_ACCESS_TOKEN= X_ACCESS_SECRET=

# Price / MAD-z (spot WSS primary, CoinGecko fallback)
SYMBOLS_UNIVERSE=BTCUSDT,ETHUSDT,SOLUSDT
PRICE_SYMBOLS=BTCUSDT,ETHUSDT,SOLUSDT
PRICE_BINANCE=true
PRICE_BYBIT=true
Z_FIRE=3.5
Z_VOL_FIRE=4.0
NOISE_FLOOR=0.0005
PRICE_WINDOW_SEC=300
PRICE_WINDOW_MS=300000
VOL_WINDOW_MS=900000
PRICE_SILENCE_MS=5000
SPIKE_COOLDOWN_MS=60000
CG_POLL_MS=20000
PRICE_FALLBACK_POLL_SEC=20
PORT=3847

# Funding (Commit B)
FUNDING_UNIVERSE=BTCUSDT,ETHUSDT,SOLUSDT
FUNDING_SYMBOLS=BTCUSDT,ETHUSDT,SOLUSDT
D_FIRE=2.0
OI_MIN_USD=50000000

# Liquidations (Commit B)
LIQ_SYMBOLS=BTCUSDT,ETHUSDT,SOLUSDT
CASCADE_USD=5000000
CASCADE_TAU_S=30
CASCADE_ASYM=4.0

# Bus (Commit B — dedup / coalesce / lanes)
COALESCE_WINDOW_MS=5000
DEDUP_WINDOW_MS=3000
TG_GLOBAL_RATE=25
TG_PER_CHAT_RATE=1
BUS_MAX_QUEUE=500
ALERT_COOLDOWN_SEC=900

# Watchdog
RSS_SOFT_MB=700
RSS_HARD_MB=820
RSS_FATAL_MB=900

# Health — for solana_whale-only, use: telegram (skip priceRouter)
HEALTH_CRITICAL_DEPS=stripe,telegram,priceRouter

# Conviction
CONVICTION_ENABLED=true
CONVICTION_PATH=./data/conviction.json
CONVICTION_MIN_OUTCOMES=200

TELEGRAM_BOT_TOKEN=
TELEGRAM_FREE_CHAT_ID=
TELEGRAM_PREMIUM_CHAT_ID=
TELEGRAM_OPS_CHAT_ID=
TELEGRAM_PREMIUM_INVITE_LINK=
# Aliases: TG_BOT_TOKEN, TG_CHANNEL, TG_PAID_CHANNEL
TWITTER_API_KEY=
TWITTER_API_SECRET=
TWITTER_ACCESS_TOKEN=
TWITTER_ACCESS_SECRET=
# Aliases: X_API_KEY, X_API_SECRET, X_ACCESS_TOKEN, X_ACCESS_SECRET
STRIPE_SECRET_KEY=
PREMIUM_PRICE_USD=29
AFFILIATE_ENABLED=true
AFFILIATE_EXCHANGE_URL=
LEGAL_DISCLAIMER_SHORT=Not financial advice. Market data & entertainment. DYOR.

# Solana-only health: HEALTH_CRITICAL_DEPS=telegram
# HEALTH_CRITICAL_DEPS=stripe,telegram,priceRouter

